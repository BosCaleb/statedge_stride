{
  "name": "statedge-stride",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm --filter @stride/web build && pnpm --filter @stride/api build",
    "test": "vitest run --project analysis --project shared --project web --project api",
    "test:db": "vitest run --project api-db",
    "test:watch": "vitest --project analysis --project shared --project web --project api",
    "lint": "eslint . && prettier --check . && stylelint \"apps/web/src/**/*.css\"",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel run typecheck && tsc -p scripts/tsconfig.json",
    "db:up": "docker compose up -d sql azurite",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "create-org": "tsx scripts/create-org.ts",
    "fetch-models": "tsx scripts/fetch-models.ts",
    "licences": "tsx scripts/check-licences.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "e2e": "pnpm --filter @stride/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  }
}
