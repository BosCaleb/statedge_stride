# Local development (`pnpm dev`): the API on the Functions host or the local server, and fake
# sign-in as a seeded person (the API honours it only with ENVIRONMENT=local, DEV_FAKE_AUTH=true).
# To sign in with a real Entra tenant locally, override these in .env.development.local.
VITE_API_BASE_URL=http://localhost:7071/api
VITE_FAKE_AUTH=true
VITE_ENABLE_DEV_PAGES=true
VITE_BUILD_VERSION=local
