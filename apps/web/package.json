{
  "name": "@stride/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode prod --outDir dist-prod && vite build --mode dev --outDir dist-dev",
    "build:dev": "vite build --mode dev --outDir dist-dev",
    "build:prod": "vite build --mode prod --outDir dist-prod",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "tsx scripts/serve-swa.ts dist-e2e",
