    "e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.27.0",
    "@azure/msal-react": "^5.7.4",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@microsoft/applicationinsights-web": "^3.4.5",
    "@stride/analysis": "workspace:*",
    "@stride/shared": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "mp4box": "^2.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "workbox-window": "^7.4.1",
